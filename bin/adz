#!/bin/bash

# ADZ WordPress Plugin Framework - CLI Tool
# Packagist-ready version with vendor isolation

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Detect framework installation
if [[ -f "vendor/adzadzadz/wp-plugin-framework/bin/adz" ]]; then
    # Running from project directory with composer-installed framework
    FRAMEWORK_DIR="vendor/adzadzadz/wp-plugin-framework"
    PROJECT_DIR="."
elif [[ -f "../../../bin/adz" ]]; then
    # Running from vendor/bin/adz
    FRAMEWORK_DIR="$(dirname "$(dirname "$(realpath "$0")")")"
    PROJECT_DIR="$(pwd)"
elif [[ "$(basename "$(dirname "$0")")" == "bin" ]]; then
    # Running from framework's bin directory (development/CI)
    FRAMEWORK_DIR="$(dirname "$(dirname "$(realpath "$0")")")"
    PROJECT_DIR="."
elif [[ "$(basename "$0")" == "adz" && -f "vendor/adzadzadz/wp-plugin-framework/composer.json" ]]; then
    # Running from copied adz file in project root
    FRAMEWORK_DIR="vendor/adzadzadz/wp-plugin-framework"
    PROJECT_DIR="."
else
    echo -e "${RED}✗${NC} ADZ Framework not found. Please run 'composer require adzadzadz/wp-plugin-framework' first."
    exit 1
fi

STUBS_DIR="$FRAMEWORK_DIR/stubs"

# Show header
show_header() {
    echo -e "${BLUE}🚀 ADZ WordPress Plugin Framework${NC}"
    echo -e "${YELLOW}   The intuitive MVC framework for WordPress plugin development${NC}"
    echo ""
}

# Show usage information
show_usage() {
    show_header
    echo "Usage: adz [command] [options]"
    echo ""
    echo -e "${GREEN}🚀 Project Setup:${NC}"
    echo "  init                        Initialize ADZ project in current directory"
    echo ""
    echo -e "${GREEN}📦 Code Generation:${NC}"
    echo "  make:controller <name>      Create a new controller"
    echo "  make:service <name>         Create a new service"
    echo "  make:model <name>           Create a new model"
    echo "  make:view <name>            Create a new view template"
    echo "  make:template <name>        Create a new template layout"
    echo "  make:migration <name>       Create a new database migration"
    echo ""
    echo -e "${GREEN}🗄️  Database Management:${NC}"
    echo "  migrate                     Run pending migrations"
    echo "  migrate:rollback [steps]    Rollback migrations (default: 1 step)"
    echo "  migrate:reset               Reset all migrations"
    echo "  migrate:status              Show migration status"
    echo ""
    echo -e "${GREEN}🔧 Framework Commands:${NC}"
    echo "  test                        Run framework tests"
    echo "  test:unit                   Run unit tests only"
    echo "  test:coverage               Run tests with coverage"
    echo ""
    echo -e "${GREEN}📦 Build & Distribution:${NC}"
    echo "  build                       Build and minify assets, create installable zip"
    echo "  build:assets                Build and minify assets only"
    echo "  build:watch                 Watch assets for changes and auto-build"
    echo "  build:zip                   Create installable plugin zip"
    echo ""
    echo -e "${GREEN}Examples:${NC}"
    echo "  adz init"
    echo "  adz make:controller PostController"
    echo "  adz make:service EmailService"
    echo "  adz make:model User --migration"
    echo "  adz make:view posts/index"
    echo "  adz migrate"
}

# Utility functions
log_success() {
    echo -e "${GREEN}✓${NC} $1"
}

log_error() {
    echo -e "${RED}✗${NC} $1" >&2
}

log_info() {
    echo -e "${BLUE}ℹ${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

# Ensure directory exists
ensure_dir() {
    if [[ ! -d "$1" ]]; then
        mkdir -p "$1"
        log_info "Created directory: $1"
    fi
}

# Check if current directory is an ADZ project
is_adz_project() {
    [[ -f "composer.json" ]] && grep -q "adz/wp-plugin-framework" composer.json
}

# Initialize ADZ project
init_project() {
    show_header
    log_info "Initializing ADZ WordPress Plugin Framework project..."
    
    # Check if already initialized
    if is_adz_project; then
        log_warning "This directory already appears to be an ADZ project."
        read -p "Continue anyway? (y/N): " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            exit 0
        fi
    fi
    
    # Create directory structure
    ensure_dir "src/controllers"
    ensure_dir "src/services"
    ensure_dir "src/models"
    ensure_dir "src/views"
    ensure_dir "config"
    ensure_dir "assets/css"
    ensure_dir "assets/js"
    ensure_dir "assets/images"
    ensure_dir "migrations"
    
    # Copy template files
    log_info "Copying template files..."
    
    # Copy composer.json
    cp "$STUBS_DIR/project-files/composer.json" "$PROJECT_DIR/"
    
    # Copy package.json
    cp "$STUBS_DIR/project-files/package.json" "$PROJECT_DIR/"
    
    # Copy phpunit.xml
    cp "$STUBS_DIR/project-files/phpunit.xml" "$PROJECT_DIR/"
    
    # Copy main plugin file
    cp "$STUBS_DIR/project-files/main-plugin-file.php" "$PROJECT_DIR/main-plugin.php"
    
    # Copy build tools
    cp -r "$STUBS_DIR/project-files/tools" "$PROJECT_DIR/"
    
    # Copy test framework
    cp -r "$STUBS_DIR/tests" "$PROJECT_DIR/"
    
    # Copy example files
    cp "$STUBS_DIR/controllers/ExampleController.php" "$PROJECT_DIR/src/controllers/"
    cp -r "$STUBS_DIR/src/Services/"* "$PROJECT_DIR/src/services/" 2>/dev/null || true
    cp "$STUBS_DIR/models/ExampleModel.php" "$PROJECT_DIR/src/models/"
    cp "$STUBS_DIR/views/example.php" "$PROJECT_DIR/src/views/"
    cp "$STUBS_DIR/config/config.php" "$PROJECT_DIR/config/"
    
    # Copy example assets
    cp -r "$STUBS_DIR/assets/"* "$PROJECT_DIR/assets/"
    
    # Create .gitignore
    cat > "$PROJECT_DIR/.gitignore" << 'EOF'
/vendor/
/node_modules/
/dist/
/coverage/
.env
.env.local
.DS_Store
*.log
composer.lock
package-lock.json
.phpunit.result.cache
EOF
    
    # Create README
    cat > "$PROJECT_DIR/README.md" << 'EOF'
# WordPress Plugin with ADZ Framework

A WordPress plugin built using the ADZ Framework.

## Installation

1. Run `composer install`
2. Run `npm install`
3. Customize your plugin details in `main-plugin.php`
4. Start building your controllers, models, and views!

## Commands

- `adz make:controller ControllerName` - Create a new controller
- `adz make:model ModelName` - Create a new model
- `adz make:view viewname` - Create a new view
- `adz migrate` - Run database migrations
- `adz build` - Build and package your plugin

## Documentation

Visit [ADZ Framework Documentation](https://github.com/adz/wp-plugin-framework) for more information.
EOF
    
    log_success "ADZ project initialized successfully!"
    log_info "Next steps:"
    echo "  1. Run 'composer install' to install dependencies"
    echo "  2. Run 'npm install' to install build tools"
    echo "  3. Customize 'main-plugin.php' with your plugin details"
    echo "  4. Start building with 'adz make:controller YourController'"
}

# Convert CamelCase to snake_case
camel_to_snake() {
    echo "$1" | sed 's/\([A-Z]\)/_\1/g' | sed 's/^_//' | tr '[:upper:]' '[:lower:]'
}

# Convert snake_case to CamelCase
snake_to_camel() {
    local input="$1"
    local result=""
    IFS='_' read -ra PARTS <<< "$input"
    for part in "${PARTS[@]}"; do
        if [[ -n "$part" ]]; then
            result="${result}$(echo "${part:0:1}" | tr '[:lower:]' '[:upper:]')${part:1}"
        fi
    done
    echo "$result"
}

# Pluralize a word
pluralize() {
    local word="$1"
    if [[ "$word" =~ y$ ]]; then
        echo "${word%y}ies"
    elif [[ "$word" =~ [sxz]$ ]] || [[ "$word" =~ [cs]h$ ]]; then
        echo "${word}es"
    else
        echo "${word}s"
    fi
}

# Generate Controller
make_controller() {
    local name="$1"
    local namespace_path="$2"
    
    if [[ -z "$name" ]]; then
        log_error "Controller name is required"
        echo "Usage: adz make:controller <ControllerName>"
        echo "Examples:"
        echo "  adz make:controller PostController"
        echo "  adz make:controller Admin/UserController"
        echo "  adz make:controller Api/V1/AuthController"
        exit 1
    fi
    
    if ! is_adz_project; then
        log_error "Not in an ADZ project directory. Run 'adz init' first."
        exit 1
    fi
    
    # Handle namespaced controllers
    if [[ "$name" == *"/"* ]]; then
        namespace_path=$(dirname "$name")
        name=$(basename "$name")
    fi
    
    # Ensure Controller suffix
    if [[ ! "$name" =~ Controller$ ]]; then
        name="${name}Controller"
    fi
    
    # Create directory structure
    local controller_dir="src/controllers"
    if [[ -n "$namespace_path" ]]; then
        controller_dir="$controller_dir/$namespace_path"
    fi
    
    ensure_dir "$controller_dir"
    
    local controller_file="$controller_dir/$name.php"
    
    if [[ -f "$controller_file" ]]; then
        log_warning "Controller already exists: $controller_file"
        read -p "Overwrite? (y/N): " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            exit 0
        fi
    fi
    
    # Generate namespace
    local namespace="App\\Controllers"
    if [[ -n "$namespace_path" ]]; then
        namespace="$namespace\\$(echo "$namespace_path" | tr '/' '\\')"
    fi
    
    # Generate controller content
    cat > "$controller_file" << EOF
<?php

namespace $namespace;

use AdzWP\\Core\\Controller;
use AdzWP\\Core\\View;

/**
 * $name - Handle ${name%Controller} related functionality
 * 
 * Controllers handle HTTP requests and coordinate between models and views.
 * They contain the application logic and decide what response to send back.
 */
class $name extends Controller
{
    /**
     * WordPress action hooks
     * 
     * Define WordPress actions that this controller should hook into.
     * Format: 'hook_name' => 'method_name'
     * 
     * Common hooks:
     * - 'init' => 'initialize' (WordPress init)
     * - 'wp_loaded' => 'onWordPressLoaded'
     * - 'admin_menu' => 'addAdminMenu'
     * - 'wp_enqueue_scripts' => 'enqueueScripts'
     * - 'wp_ajax_action_name' => 'handleAjaxRequest'
     * - 'wp_ajax_nopriv_action_name' => 'handlePublicAjaxRequest'
     */
    public \$actions = [
        'init' => 'initialize',
        // 'wp_enqueue_scripts' => 'enqueueScripts',
        // 'admin_menu' => 'addAdminMenu',
    ];

    /**
     * WordPress filter hooks
     * 
     * Define WordPress filters that this controller should hook into.
     * Format: 'filter_name' => 'method_name'
     * 
     * Common filters:
     * - 'the_content' => 'modifyContent'
     * - 'wp_title' => 'modifyTitle'
     * - 'body_class' => 'addBodyClasses'
     */
    public \$filters = [
        // 'the_content' => 'modifyContent',
        // 'body_class' => 'addBodyClasses',
    ];

    /**
     * Controller initialization
     * 
     * This method is called when the controller is instantiated.
     * Use it for any setup that needs to happen before WordPress hooks are registered.
     */
    protected function bootstrap()
    {
        // Initialize services, set up dependencies, etc.
        // Example: \$this->userService = new UserService();
    }

    /**
     * WordPress initialization hook
     * 
     * Called during WordPress 'init' action. Use this for functionality
     * that needs WordPress to be fully loaded.
     */
    public function initialize()
    {
        // WordPress initialization logic
        if (\$this->isAdmin()) {
            // Admin-specific initialization
            \$this->initializeAdmin();
        }
        
        if (\$this->isFrontend()) {
            // Frontend-specific initialization
            \$this->initializeFrontend();
        }
        
        // Common initialization for both admin and frontend
        \$this->initializeCommon();
    }

    /**
     * Admin-specific initialization
     */
    private function initializeAdmin()
    {
        // Admin dashboard functionality
        // Example: add_action('admin_enqueue_scripts', [\$this, 'enqueueAdminScripts']);
    }

    /**
     * Frontend-specific initialization
     */
    private function initializeFrontend()
    {
        // Frontend functionality
        // Example: add_shortcode('my_shortcode', [\$this, 'handleShortcode']);
    }

    /**
     * Common initialization for both admin and frontend
     */
    private function initializeCommon()
    {
        // Shared functionality
        // Example: register custom post types, taxonomies, etc.
    }

    /**
     * Example: Handle AJAX requests
     * 
     * To use this method, add to \$actions array:
     * 'wp_ajax_my_action' => 'handleAjaxRequest'
     * 'wp_ajax_nopriv_my_action' => 'handleAjaxRequest' (for non-logged-in users)
     */
    public function handleAjaxRequest()
    {
        // Verify nonce for security
        if (!wp_verify_nonce(\$_POST['nonce'] ?? '', 'my_action_nonce')) {
            wp_die('Security check failed', 'Error', ['response' => 403]);
        }

        // Process request
        \$data = sanitize_text_field(\$_POST['data'] ?? '');
        
        // Return JSON response
        wp_send_json_success([
            'message' => 'Request processed successfully',
            'data' => \$data
        ]);
    }

    /**
     * Example: Enqueue scripts and styles
     * 
     * To use this method, add to \$actions array:
     * 'wp_enqueue_scripts' => 'enqueueScripts'
     */
    public function enqueueScripts()
    {
        // Enqueue JavaScript
        wp_enqueue_script(
            '$(echo "${name%Controller}" | tr '[:upper:]' '[:lower:]')-script',
            plugin_dir_url(__FILE__) . '../assets/js/script.js',
            ['jquery'],
            '1.0.0',
            true
        );

        // Enqueue CSS
        wp_enqueue_style(
            '$(echo "${name%Controller}" | tr '[:upper:]' '[:lower:]')-style',
            plugin_dir_url(__FILE__) . '../assets/css/style.css',
            [],
            '1.0.0'
        );

        // Localize script for AJAX
        wp_localize_script('$(echo "${name%Controller}" | tr '[:upper:]' '[:lower:]')-script', 'ajaxObject', [
            'ajaxUrl' => admin_url('admin-ajax.php'),
            'nonce' => wp_create_nonce('my_action_nonce')
        ]);
    }

    /**
     * Example: Add admin menu page
     * 
     * To use this method, add to \$actions array:
     * 'admin_menu' => 'addAdminMenu'
     */
    public function addAdminMenu()
    {
        add_options_page(
            'My Plugin Settings',           // Page title
            'My Plugin',                    // Menu title
            'manage_options',               // Capability
            'my-plugin-settings',           // Menu slug
            [\$this, 'renderAdminPage']     // Callback function
        );
    }

    /**
     * Example: Render admin page
     */
    public function renderAdminPage()
    {
        \$data = [
            'title' => 'Plugin Settings',
            'settings' => get_option('my_plugin_settings', [])
        ];
        
        // Render view with admin template
        echo View::render('admin/settings', \$data, true, 'templates/admin');
    }

    /**
     * Example: Handle shortcode
     * 
     * Usage: [my_shortcode title="Hello" content="World"]
     */
    public function handleShortcode(\$atts, \$content = '')
    {
        // Parse shortcode attributes
        \$atts = shortcode_atts([
            'title' => 'Default Title',
            'class' => 'my-shortcode'
        ], \$atts);

        // Prepare data for view
        \$data = [
            'title' => sanitize_text_field(\$atts['title']),
            'content' => wp_kses_post(\$content),
            'class' => sanitize_html_class(\$atts['class'])
        ];

        // Return rendered view (don't echo for shortcodes)
        return View::render('shortcodes/my-shortcode', \$data);
    }

    /**
     * Example: Modify content filter
     * 
     * To use this method, add to \$filters array:
     * 'the_content' => 'modifyContent'
     */
    public function modifyContent(\$content)
    {
        // Only modify content on single posts
        if (!is_single()) {
            return \$content;
        }

        // Add custom content before the post content
        \$custom_content = '<div class="custom-content">Custom content here</div>';
        
        return \$custom_content . \$content;
    }

    /**
     * Example: Add custom body classes
     * 
     * To use this method, add to \$filters array:
     * 'body_class' => 'addBodyClasses'
     */
    public function addBodyClasses(\$classes)
    {
        // Add custom class based on condition
        if (is_user_logged_in()) {
            \$classes[] = 'logged-in-user';
        }
        
        return \$classes;
    }
}
EOF
    
    log_success "Controller created: $controller_file"
    log_info "Usage examples:"
    echo "  - Register controller: new \\$namespace\\$name();"
    echo "  - Add AJAX action: 'wp_ajax_my_action' => 'handleAjaxRequest'"
    echo "  - Add admin menu: 'admin_menu' => 'addAdminMenu'"
    echo "  - Enqueue scripts: 'wp_enqueue_scripts' => 'enqueueScripts'"
}

# Generate Model
make_model() {
    local name="$1"
    local create_migration="$2"
    
    if [[ -z "$name" ]]; then
        log_error "Model name is required"
        echo "Usage: adz make:model <ModelName> [--migration]"
        echo "Examples:"
        echo "  adz make:model User"
        echo "  adz make:model Post --migration"
        echo "  adz make:model ProductCategory"
        exit 1
    fi
    
    if ! is_adz_project; then
        log_error "Not in an ADZ project directory. Run 'adz init' first."
        exit 1
    fi
    
    # Ensure Model suffix
    if [[ ! "$name" =~ Model$ ]]; then
        name="${name}Model"
    fi
    
    ensure_dir "src/models"
    
    local model_file="src/models/$name.php"
    
    if [[ -f "$model_file" ]]; then
        log_warning "Model already exists: $model_file"
        read -p "Overwrite? (y/N): " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            exit 0
        fi
    fi
    
    # Generate table name from model name
    local base_name="${name%Model}"
    local table_name=$(pluralize $(camel_to_snake "$base_name"))
    
    # Generate model content
    cat > "$model_file" << EOF
<?php

namespace App\\Models;

use AdzWP\\Core\\Model;

/**
 * $name - Represents ${base_name} entities
 * 
 * Models handle data operations and business logic related to database entities.
 * They provide an abstraction layer between your application and the database.
 */
class $name extends Model
{
    /**
     * The table associated with the model
     * 
     * @var string
     */
    protected \$table = '$table_name';
    
    /**
     * The primary key for the model
     * 
     * @var string
     */
    protected \$primaryKey = 'id';
    
    /**
     * Indicates if the model should be timestamped
     * 
     * @var bool
     */
    public \$timestamps = true;
    
    /**
     * The attributes that are mass assignable
     * 
     * Define which attributes can be mass-assigned using create() or fill() methods.
     * This is a security feature to prevent mass assignment vulnerabilities.
     * 
     * @var array
     */
    protected \$fillable = [
        // 'name',
        // 'email',
        // 'description',
        // 'status',
    ];
    
    /**
     * The attributes that aren't mass assignable
     * 
     * Define which attributes should never be mass-assigned.
     * Use either \$fillable (whitelist) or \$guarded (blacklist), not both.
     * 
     * @var array
     */
    protected \$guarded = [
        'id',
        'created_at',
        'updated_at',
    ];
    
    /**
     * The attributes that should be cast to native types
     * 
     * @var array
     */
    protected \$casts = [
        // 'is_active' => 'boolean',
        // 'settings' => 'array',
        // 'published_at' => 'datetime',
    ];
    
    /**
     * The attributes that should be hidden for serialization
     * 
     * @var array
     */
    protected \$hidden = [
        // 'password',
        // 'remember_token',
    ];

    /**
     * Example: Get all active records
     * 
     * Scope methods allow you to define reusable query constraints.
     * Use scope methods to encapsulate common query patterns.
     * 
     * @param \\Illuminate\\Database\\Eloquent\\Builder \$query
     * @return \\Illuminate\\Database\\Eloquent\\Builder
     */
    public function scopeActive(\$query)
    {
        return \$query->where('status', 'active');
    }

    /**
     * Example: Get records created in the last N days
     * 
     * @param \\Illuminate\\Database\\Eloquent\\Builder \$query
     * @param int \$days
     * @return \\Illuminate\\Database\\Eloquent\\Builder
     */
    public function scopeRecent(\$query, \$days = 7)
    {
        return \$query->where('created_at', '>=', 
            gmdate('Y-m-d H:i:s', strtotime("-{\$days} days")));
    }

    /**
     * Example: Get full name attribute (accessor)
     * 
     * Accessors allow you to format Eloquent attribute values when you access them.
     * Define an accessor by creating a getFooAttribute method.
     * 
     * Usage: \$model->full_name
     * 
     * @return string
     */
    public function getFullNameAttribute()
    {
        return \$this->first_name . ' ' . \$this->last_name;
    }

    /**
     * Example: Set password attribute (mutator)
     * 
     * Mutators allow you to format Eloquent attribute values when you set them.
     * Define a mutator by creating a setFooAttribute method.
     * 
     * Usage: \$model->password = 'plaintext';
     * 
     * @param string \$value
     */
    public function setPasswordAttribute(\$value)
    {
        \$this->attributes['password'] = password_hash(\$value, PASSWORD_DEFAULT);
    }

    /**
     * Example: One-to-many relationship
     * 
     * Define a one-to-many relationship. For example, a User has many Posts.
     * 
     * Usage: \$${base_name}->posts
     * 
     * @return \\Illuminate\\Database\\Eloquent\\Relations\\HasMany
     */
    public function posts()
    {
        return \$this->hasMany(PostModel::class, '${base_name}_id');
    }

    /**
     * Example: Many-to-one (belongs to) relationship
     * 
     * Define a belongs-to relationship. For example, a Post belongs to a User.
     * 
     * Usage: \$${base_name}->user
     * 
     * @return \\Illuminate\\Database\\Eloquent\\Relations\\BelongsTo
     */
    public function user()
    {
        return \$this->belongsTo(UserModel::class, 'user_id');
    }

    /**
     * Example: Many-to-many relationship
     * 
     * Define a many-to-many relationship. For example, a User has many Roles.
     * 
     * Usage: \$${base_name}->roles
     * 
     * @return \\Illuminate\\Database\\Eloquent\\Relations\\BelongsToMany
     */
    public function roles()
    {
        return \$this->belongsToMany(
            RoleModel::class, 
            '${base_name}_roles', // pivot table name
            '${base_name}_id',    // foreign key on pivot table
            'role_id'         // related key on pivot table
        );
    }

    /**
     * Example: Custom query method
     * 
     * Custom methods can encapsulate complex business logic.
     * 
     * @param string \$status
     * @return \\Illuminate\\Database\\Eloquent\\Collection
     */
    public function getByStatus(\$status)
    {
        return static::where('status', \$status)
            ->orderBy('created_at', 'desc')
            ->get();
    }

    /**
     * Example: Create a new record with validation
     * 
     * @param array \$data
     * @return static|false
     */
    public function createWithValidation(array \$data)
    {
        // Validate data
        \$errors = \$this->validate(\$data);
        if (!empty(\$errors)) {
            return false;
        }

        // Create record
        return static::create(\$data);
    }

    /**
     * Example: Simple validation method
     * 
     * @param array \$data
     * @return array Array of validation errors
     */
    protected function validate(array \$data)
    {
        \$errors = [];

        // Example validations
        if (empty(\$data['name'])) {
            \$errors['name'] = 'Name is required';
        }

        if (!empty(\$data['email']) && !filter_var(\$data['email'], FILTER_VALIDATE_EMAIL)) {
            \$errors['email'] = 'Invalid email format';
        }

        return \$errors;
    }

    /**
     * Boot method - called when model is being booted
     * 
     * Use this method to register model event listeners or perform
     * other initialization tasks.
     */
    protected static function boot()
    {
        parent::boot();

        // Example: Automatically set slug when creating
        static::creating(function (\$model) {
            if (empty(\$model->slug) && !empty(\$model->name)) {
                \$model->slug = sanitize_title(\$model->name);
            }
        });

        // Example: Log when model is updated
        static::updated(function (\$model) {
            error_log("${name} updated: " . \$model->id);
        });
    }
}
EOF
    
    log_success "Model created: $model_file"
    log_info "Usage examples:"
    echo "  - Create: \$${base_name} = ${name}::create(\$data);"
    echo "  - Find: \$${base_name} = ${name}::find(\$id);"
    echo "  - Query: \$${base_name}s = ${name}::active()->recent(30)->get();"
    echo "  - Relationship: \$${base_name}->posts()->where('status', 'published')->get();"
    
    # Create migration if requested
    if [[ "$create_migration" == "--migration" ]] || [[ "$3" == "--migration" ]]; then
        make_migration "create_${table_name}_table"
    fi
}

# Generate View
make_view() {
    local name="$1"
    
    if [[ -z "$name" ]]; then
        log_error "View name is required"
        echo "Usage: adz make:view <path/viewname>"
        echo "Examples:"
        echo "  adz make:view dashboard"
        echo "  adz make:view admin/users"
        echo "  adz make:view partials/header"
        echo "  adz make:view emails/welcome"
        exit 1
    fi
    
    if ! is_adz_project; then
        log_error "Not in an ADZ project directory. Run 'adz init' first."
        exit 1
    fi
    
    local view_dir="src/views/$(dirname "$name")"
    local view_name="$(basename "$name")"
    
    ensure_dir "$view_dir"
    
    local view_file="$view_dir/$view_name.php"
    
    if [[ -f "$view_file" ]]; then
        log_warning "View already exists: $view_file"
        read -p "Overwrite? (y/N): " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            exit 0
        fi
    fi
    
    # Generate view content
    cat > "$view_file" << 'EOF'
<?php
/**
 * View Template: <?php echo basename("$name"); ?>

 * 
 * This view file contains the HTML markup and PHP logic for rendering content.
 * Views should focus on presentation logic only - business logic belongs in controllers and services.
 * 
 * Available variables:
 * - All variables passed from the controller via View::render()
 * - WordPress globals: $post, $wp_query, etc. (if applicable)
 * 
 * Security:
 * - Always escape output using esc_html(), esc_attr(), wp_kses_post(), etc.
 * - Use WordPress sanitization functions for user input
 * - Never output raw user data without escaping
 * 
 * Usage in controller:
 * echo View::render('<?php echo "$name"; ?>', [
 *     'title' => 'Page Title',
 *     'data' => $processedData,
 *     'user' => $currentUser
 * ]);
 */

// Prevent direct access
if (!defined('ABSPATH')) {
    exit;
}
?>

<div class="adz-view adz-view--<?php echo esc_attr(str_replace(['/', '_'], '-', '$name')); ?>">
    <?php if (isset($title)): ?>
        <header class="view-header">
            <h1 class="view-title"><?php echo esc_html($title); ?></h1>
            
            <?php if (isset($subtitle)): ?>
                <p class="view-subtitle"><?php echo esc_html($subtitle); ?></p>
            <?php endif; ?>
        </header>
    <?php endif; ?>
    
    <main class="view-content">
        <?php if (isset($content)): ?>
            <!-- Main content area -->
            <div class="content-area">
                <?php echo wp_kses_post($content); ?>
            </div>
        <?php endif; ?>
        
        <?php if (isset($items) && is_array($items)): ?>
            <!-- List of items -->
            <div class="items-list">
                <?php foreach ($items as $item): ?>
                    <div class="item">
                        <?php if (isset($item['title'])): ?>
                            <h3 class="item-title"><?php echo esc_html($item['title']); ?></h3>
                        <?php endif; ?>
                        
                        <?php if (isset($item['content'])): ?>
                            <div class="item-content">
                                <?php echo wp_kses_post($item['content']); ?>
                            </div>
                        <?php endif; ?>
                        
                        <?php if (isset($item['meta']) && is_array($item['meta'])): ?>
                            <div class="item-meta">
                                <?php foreach ($item['meta'] as $key => $value): ?>
                                    <span class="meta-item">
                                        <strong><?php echo esc_html($key); ?>:</strong>
                                        <?php echo esc_html($value); ?>
                                    </span>
                                <?php endforeach; ?>
                            </div>
                        <?php endif; ?>
                    </div>
                <?php endforeach; ?>
            </div>
        <?php endif; ?>
        
        <?php if (isset($form_fields) && is_array($form_fields)): ?>
            <!-- Dynamic form -->
            <form class="adz-form" method="post" action="">
                <?php wp_nonce_field('form_action', 'form_nonce'); ?>
                
                <?php foreach ($form_fields as $field): ?>
                    <div class="form-field">
                        <label for="<?php echo esc_attr($field['name']); ?>">
                            <?php echo esc_html($field['label']); ?>
                            <?php if (isset($field['required']) && $field['required']): ?>
                                <span class="required">*</span>
                            <?php endif; ?>
                        </label>
                        
                        <?php switch ($field['type']): 
                            case 'textarea': ?>
                                <textarea 
                                    name="<?php echo esc_attr($field['name']); ?>" 
                                    id="<?php echo esc_attr($field['name']); ?>"
                                    <?php echo isset($field['required']) && $field['required'] ? 'required' : ''; ?>
                                ><?php echo esc_textarea($field['value'] ?? ''); ?></textarea>
                                <?php break; 
                            
                            case 'select': ?>
                                <select 
                                    name="<?php echo esc_attr($field['name']); ?>" 
                                    id="<?php echo esc_attr($field['name']); ?>"
                                    <?php echo isset($field['required']) && $field['required'] ? 'required' : ''; ?>
                                >
                                    <?php if (isset($field['options']) && is_array($field['options'])): ?>
                                        <?php foreach ($field['options'] as $value => $label): ?>
                                            <option value="<?php echo esc_attr($value); ?>" 
                                                <?php selected($field['value'] ?? '', $value); ?>>
                                                <?php echo esc_html($label); ?>
                                            </option>
                                        <?php endforeach; ?>
                                    <?php endif; ?>
                                </select>
                                <?php break; 
                            
                            default: ?>
                                <input 
                                    type="<?php echo esc_attr($field['type'] ?? 'text'); ?>" 
                                    name="<?php echo esc_attr($field['name']); ?>" 
                                    id="<?php echo esc_attr($field['name']); ?>"
                                    value="<?php echo esc_attr($field['value'] ?? ''); ?>"
                                    <?php echo isset($field['required']) && $field['required'] ? 'required' : ''; ?>
                                    <?php if (isset($field['placeholder'])): ?>
                                        placeholder="<?php echo esc_attr($field['placeholder']); ?>"
                                    <?php endif; ?>
                                />
                                <?php break; 
                        endswitch; ?>
                        
                        <?php if (isset($field['description'])): ?>
                            <p class="field-description"><?php echo esc_html($field['description']); ?></p>
                        <?php endif; ?>
                    </div>
                <?php endforeach; ?>
                
                <div class="form-actions">
                    <button type="submit" class="button button-primary">
                        <?php echo esc_html($submit_text ?? 'Submit'); ?>
                    </button>
                </div>
            </form>
        <?php endif; ?>
        
        <?php if (isset($messages) && is_array($messages)): ?>
            <!-- Messages/alerts -->
            <div class="messages">
                <?php foreach ($messages as $message): ?>
                    <div class="message message--<?php echo esc_attr($message['type'] ?? 'info'); ?>">
                        <?php echo esc_html($message['text']); ?>
                    </div>
                <?php endforeach; ?>
            </div>
        <?php endif; ?>
        
        <?php if (empty($content) && empty($items) && empty($form_fields)): ?>
            <!-- Default content when no specific data is provided -->
            <div class="default-content">
                <p><?php esc_html_e('No content available.', 'textdomain'); ?></p>
            </div>
        <?php endif; ?>
    </main>
    
    <?php if (isset($actions) && is_array($actions)): ?>
        <!-- Action buttons -->
        <footer class="view-actions">
            <?php foreach ($actions as $action): ?>
                <a href="<?php echo esc_url($action['url']); ?>" 
                   class="button <?php echo esc_attr($action['class'] ?? 'button-secondary'); ?>"
                   <?php if (isset($action['target'])): ?>
                       target="<?php echo esc_attr($action['target']); ?>"
                   <?php endif; ?>>
                    <?php echo esc_html($action['label']); ?>
                </a>
            <?php endforeach; ?>
        </footer>
    <?php endif; ?>
</div>

<?php
/**
 * Action hook for adding custom content after the view
 * 
 * @param array $data All data passed to this view
 */
do_action('adz_after_view_<?php echo str_replace(['/', '-'], '_', '$name'); ?>', get_defined_vars());
?>
EOF
    
    log_success "View created: $view_file"
    log_info "Usage examples:"
    echo "  - Basic: View::render('$name', ['title' => 'Page Title']);"
    echo "  - With items: View::render('$name', ['items' => \$dataArray]);"
    echo "  - With form: View::render('$name', ['form_fields' => \$formConfig]);"
    echo "  - Custom template: View::render('$name', \$data, true, 'templates/custom');"
}

# Generate Migration
make_migration() {
    local name="$1"
    
    if [[ -z "$name" ]]; then
        log_error "Migration name is required"
        echo "Usage: adz make:migration <migration_name>"
        exit 1
    fi
    
    if ! is_adz_project; then
        log_error "Not in an ADZ project directory. Run 'adz init' first."
        exit 1
    fi
    
    ensure_dir "migrations"
    
    local timestamp=$(date +"%Y_%m_%d_%H%M%S")
    local migration_file="migrations/${timestamp}_${name}.php"
    local class_name=$(snake_to_camel "$name")
    
    # Generate migration content
    cat > "$migration_file" << EOF
<?php

use Adz\\Database\\Migration;

class $class_name extends Migration
{
    /**
     * Run the migration
     */
    public function up()
    {
        // Example: Create a new table
        \$this->createTable('example_table', function(\$table) {
            \$table->id();
            \$table->string('name');
            \$table->text('description')->nullable();
            \$table->boolean('is_active')->default(1);
            \$table->timestamps();
        });
    }

    /**
     * Reverse the migration
     */
    public function down()
    {
        \$this->dropTable('example_table');
    }
}
EOF
    
    log_success "Migration created: $migration_file"
    log_info "Run 'adz migrate' to execute pending migrations"
}

# Generate Service
make_service() {
    local name="$1"
    
    if [[ -z "$name" ]]; then
        log_error "Service name is required"
        echo "Usage: adz make:service <ServiceName>"
        exit 1
    fi
    
    if ! is_adz_project; then
        log_error "Not in an ADZ project directory. Run 'adz init' first."
        exit 1
    fi
    
    # Ensure Service suffix
    if [[ ! "$name" =~ Service$ ]]; then
        name="${name}Service"
    fi
    
    ensure_dir "src/services"
    
    local service_file="src/services/$name.php"
    
    if [[ -f "$service_file" ]]; then
        log_warning "Service already exists: $service_file"
        read -p "Overwrite? (y/N): " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            exit 0
        fi
    fi
    
    # Generate service content
    cat > "$service_file" << EOF
<?php

namespace App\\Services;

use AdzWP\\Core\\Service;

/**
 * $name - Handle business logic for ${name%Service}
 * 
 * Services are used to encapsulate business logic and can be injected into controllers
 * and other services through the dependency injection container.
 */
class $name extends Service
{
    /**
     * Define service dependencies (optional)
     * 
     * Services can depend on other services. The framework will automatically
     * resolve and inject these dependencies when the service is instantiated.
     * 
     * @return array Array of service names this service depends on
     * 
     * Example:
     * return ['user', 'email', 'cache'];
     */
    protected function dependencies(): array
    {
        return [
            // Add dependency service names here
        ];
    }

    /**
     * Service initialization (optional)
     * 
     * This method is called after all dependencies have been injected.
     * Use it to perform any initialization logic.
     */
    protected function initialize(): void
    {
        // Initialization logic here
    }

    /**
     * Example: Process data method
     * 
     * Services should contain business logic methods that can be called
     * from controllers or other services.
     * 
     * @param array \$data The data to process
     * @return bool Success status
     */
    public function processData(array \$data): bool
    {
        // Validate input data
        if (empty(\$data)) {
            return false;
        }

        // Process the data
        foreach (\$data as \$key => \$value) {
            // Sanitize and process each item
            \$data[\$key] = sanitize_text_field(\$value);
        }

        // Store or handle processed data
        return \$this->storeData(\$data);
    }

    /**
     * Example: Get formatted data
     * 
     * @param int \$id Data identifier
     * @return array|null Formatted data or null if not found
     */
    public function getFormattedData(int \$id): ?array
    {
        // Retrieve data (example using WordPress options)
        \$data = get_option("data_{\$id}", null);
        
        if (!\$data) {
            return null;
        }

        // Format and return data
        return [
            'id' => \$id,
            'formatted_data' => \$this->formatData(\$data),
            'timestamp' => current_time('timestamp'),
        ];
    }

    /**
     * Example: Service method with dependency usage
     * 
     * Access injected dependencies through their service names.
     * Dependencies are automatically camelCased (e.g., 'user_service' becomes \$this->userService).
     * 
     * @param int \$userId User ID
     * @return array Processing result
     */
    public function processWithDependency(int \$userId): array
    {
        // Example: Access injected services
        // \$userName = \$this->userService->getDisplayName(\$userId);
        // \$this->emailService->send(\$userId, 'Processing complete');
        // \$this->cacheService->store("process_{\$userId}", \$result);
        
        return [
            'status' => 'success',
            'message' => 'Processing completed',
            'user_id' => \$userId,
            'processed_at' => current_time('mysql')
        ];
    }

    /**
     * Example: Validation method
     * 
     * @param array \$input Input data to validate
     * @return array Validation result with errors
     */
    public function validateInput(array \$input): array
    {
        \$errors = [];
        
        // Example validations
        if (empty(\$input['required_field'])) {
            \$errors['required_field'] = 'This field is required';
        }
        
        if (isset(\$input['email']) && !is_email(\$input['email'])) {
            \$errors['email'] = 'Please enter a valid email address';
        }
        
        return [
            'valid' => empty(\$errors),
            'errors' => \$errors
        ];
    }

    /**
     * Private helper method for data storage
     * 
     * @param array \$data Data to store
     * @return bool Success status
     */
    private function storeData(array \$data): bool
    {
        // Example: Store in WordPress options table
        \$key = 'processed_data_' . time();
        return update_option(\$key, \$data);
    }

    /**
     * Private helper method for data formatting
     * 
     * @param mixed \$data Raw data
     * @return array Formatted data
     */
    private function formatData(\$data): array
    {
        if (is_array(\$data)) {
            return \$data;
        }
        
        return ['value' => \$data];
    }
}
EOF
    
    log_success "Service created: $service_file"
    log_info "Usage examples:"
    echo "  - In controller: \$service = new \\App\\Services\\$name();"
    echo "  - With DI: \$service = \$this->container->get('$(echo "${name%Service}" | tr '[:upper:]' '[:lower:]')');"
    echo "  - Call methods: \$result = \$service->processData(\$data);"
}

# Generate Template
make_template() {
    local name="$1"
    
    if [[ -z "$name" ]]; then
        log_error "Template name is required"
        echo "Usage: adz make:template <templatename>"
        echo "Example: adz make:template admin"
        exit 1
    fi
    
    if ! is_adz_project; then
        log_error "Not in an ADZ project directory. Run 'adz init' first."
        exit 1
    fi
    
    local template_dir="src/views/templates"
    ensure_dir "\$template_dir"
    
    local template_file="\$template_dir/\$name.php"
    
    if [[ -f "\$template_file" ]]; then
        log_warning "Template already exists: \$template_file"
        read -p "Overwrite? (y/N): " -n 1 -r
        echo
        if [[ ! \$REPLY =~ ^[Yy]$ ]]; then
            exit 0
        fi
    fi
    
    # Generate template content
    cat > "\$template_file" << 'EOF'
<?php
/**
 * Template Layout
 * 
 * This template wraps view content and provides the overall page structure.
 * 
 * Available variables:
 * - \$content: The rendered view content
 * - \$title: Page title (if set)
 * - \$header_content: Header content (if set)
 * - \$footer_content: Footer content (if set)
 * - All variables passed from the controller
 */

// Prevent direct access
if (!defined('ABSPATH')) {
    exit;
}
?>
<!DOCTYPE html>
<html <?php language_attributes(); ?>>
<head>
    <meta charset="<?php bloginfo('charset'); ?>">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    
    <?php if (isset(\$title)): ?>
        <title><?php echo esc_html(\$title); ?> | <?php bloginfo('name'); ?></title>
    <?php endif; ?>
    
    <?php wp_head(); ?>
</head>
<body <?php body_class(); ?>>
    <?php wp_body_open(); ?>
    
    <div class="site-wrapper">
        <?php if (isset(\$header_content)): ?>
            <header class="site-header">
                <?php echo wp_kses_post(\$header_content); ?>
            </header>
        <?php endif; ?>
        
        <main class="site-main">
            <div class="container">
                <?php echo \$content; ?>
            </div>
        </main>
        
        <?php if (isset(\$footer_content)): ?>
            <footer class="site-footer">
                <?php echo wp_kses_post(\$footer_content); ?>
            </footer>
        <?php endif; ?>
    </div>
    
    <?php wp_footer(); ?>
</body>
</html>
EOF
    
    log_success "Template created: \$template_file"
    log_info "Usage: View::render('viewname', \$data, true, 'templates/$name')"
}

# Proxy other commands to existing functionality if available
proxy_command() {
    local command="$1"
    shift
    
    if [[ -f "tools/build.js" ]]; then
        case "$command" in
            "build"|"build:assets"|"build:watch"|"build:zip")
                if command -v node &> /dev/null; then
                    case "$command" in
                        "build") node tools/build.js "$@" ;;
                        "build:assets") node tools/build-assets.js "$@" ;;
                        "build:watch") node tools/build-assets.js --watch ;;
                        "build:zip") node tools/build-zip.js "$@" ;;
                    esac
                else
                    log_error "Node.js is required for build commands"
                    exit 1
                fi
                ;;
        esac
    fi
    
    if [[ -f "vendor/bin/phpunit" ]]; then
        case "$command" in
            "test") ./vendor/bin/phpunit ;;
            "test:unit") ./vendor/bin/phpunit --testsuite=Unit ;;
            "test:coverage") ./vendor/bin/phpunit --coverage-html coverage ;;
        esac
    fi
}

# Main command dispatcher
main() {
    local command="$1"
    
    case "$command" in
        "init")
            init_project
            ;;
        "make:controller")
            make_controller "$2" "$3"
            ;;
        "make:model")
            make_model "$2" "$3"
            ;;
        "make:view")
            make_view "$2"
            ;;
        "make:migration")
            make_migration "$2"
            ;;
        "make:service")
            make_service "$2"
            ;;
        "make:template")
            make_template "$2"
            ;;
        "build"|"build:assets"|"build:watch"|"build:zip"|"test"|"test:unit"|"test:coverage")
            proxy_command "$@"
            ;;
        "help"|"--help"|"-h"|"")
            show_usage
            ;;
        *)
            log_error "Unknown command: $command"
            echo ""
            show_usage
            exit 1
            ;;
    esac
}

# Run the main function with all arguments
main "$@"