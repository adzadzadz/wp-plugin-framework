{
    "name": "adz/wp-plugin-framework",
    "description": "The intuitive MVC framework for WordPress plugin development",
    "type": "library",
    "keywords": [
        "wordpress",
        "framework",
        "mvc",
        "plugin",
        "development",
        "php"
    ],
    "homepage": "https://github.com/adz/wp-plugin-framework",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Adrian T. Saycon",
            "email": "adrian.saycon.t@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "mockery/mockery": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "AdzWP\\": "src/"
        },
        "classmap": [
            "src/Adz.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/adz"
    ],
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:coverage": "phpunit --coverage-html coverage"
    },
    "support": {
        "issues": "https://github.com/adz/wp-plugin-framework/issues",
        "source": "https://github.com/adz/wp-plugin-framework"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}